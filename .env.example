PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autopilot
FRONTEND_ORIGIN=https://your-domain.example
AUTOPILOT_HOME=/home/<your-username>/.autopilot
NODE_ENV=production # Optional
VITE_API_URL=https://your-backend-domain.example

# ─── Authentication / Sessions ──────────────────────────────
AUTH_COOKIE_SECRET=replace-with-a-long-random-secret-at-least-32-chars
TRUST_PROXY= # Optional: set only when deployed behind a trusted reverse proxy (example: 1)
SESSION_TTL_DAYS=14
AUTH_REVOKE_OTHER_SESSIONS_ON_PASSWORD_CHANGE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend-domain.example/api/auth/google/callback

# ─── Workflow / Webhook Integration ─────────────────────────
# Optional fallback secret for provider callbacks to /api/webhooks/*.
# Preferred: generate/revoke keys from Settings > Webhook Callbacks.
WEBHOOK_CALLBACK_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CALLBACK_BASE_URL=https://your-backend-domain.example

# ─── LLM Provider Defaults ──────────────────────────────────
PROVIDER_API_KEY_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-chars
OLLAMA_URL=http://ollama.internal:11434 # Set explicitly in production;
CLAMAV_HOST=127.0.0.1 # Optional
CLAMAV_PORT=3310 # Optional
ATTACHMENT_SCAN_HTTP_URL= # Optional
ATTACHMENT_SCAN_HTTP_TOKEN= # Optional

# ─── Stability Rollout Flags (Compatibility-First) ──────────
FEATURE_STRUCTURED_LOGGING=false
FEATURE_CROSS_ORIGIN_ISOLATION=false

# ─── Web Push (WhatsApp/Telegram-style browser push) ────────
# Generate once and keep stable in production:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY= # Optional (required only for push notifications)
VAPID_PRIVATE_KEY= # Optional (required only for push notifications)
VAPID_SUBJECT=mailto:ajayduddi.work@gmail.com # Optional (required only for push notifications)
