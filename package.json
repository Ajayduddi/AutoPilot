{
  "name": "autopilot",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@hono/node-server": "1.19.13",
    "brace-expansion": "2.0.3",
    "defu": "6.1.5",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.0",
    "h3": "1.15.9",
    "hono": "4.12.14",
    "follow-redirects": "1.16.0",
    "lodash": "4.18.1",
    "node-forge": "1.4.0",
    "picomatch": "2.3.2",
    "protobufjs": "7.5.5",
    "serialize-javascript": "7.0.5",
    "vite": "6.4.2"
  },
  "scripts": {
    "dev": "bun --filter='*' run dev",
    "build": "bun --filter='*' run build",
    "typecheck": "bun --filter='*' run typecheck",
    "test": "bun --filter='*' run test",
    "ci:check-pr-size": "bun scripts/ci/check-pr-size.ts",
    "ci:check-migration-journal": "bun scripts/ci/check-migration-journal.ts",
    "ci:check-bun-native": "bun scripts/ci/check-bun-native.ts",
    "ci:check-dependency-audit": "bun scripts/ci/check-dependency-audit.ts",
    "ci:check-runtime-logging": "bun scripts/ci/check-runtime-logging.ts",
    "ci:report-runtime-module-sizes": "bun scripts/ci/report-runtime-module-sizes.ts"
  }
}
